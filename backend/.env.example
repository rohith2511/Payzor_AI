# Payzor AI Revenue Recovery - Backend Environment Configuration Example
# Copy this file to .env and configure the variables with your local values.

# --- DATABASE CONFIGURATION ---
DATABASE_URL=sqlite:///./payzor.db

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET=your_jwt_signing_secret_here
ENCRYPTION_KEY=your_aes_encryption_key_here

# --- AI INTEGRATION (GROQ QWEN) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- SYSTEM SETTINGS ---
DEBUG=True
CORS_ORIGINS=*
