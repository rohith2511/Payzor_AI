*.py[cod]
*$py.class
*.db
*.sqlite3
.venv/
venv/
ENV/
backend/payzor.db
backend/reachable_crm.db

# Javascript / Node (Frontend)
node_modules/
dist/
dist-ssr/
*.local
.eslintcache

# Logs & OS Files
*.log
.DS_Store
Thumbs.db
.agents/
.gemini/
